{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:parser": "esbuild scripts/parser-check.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/parser-check.cjs --log-level=error && node node_modules/.cache/parser-check.cjs",
    "check": "tsc --noEmit && npm run check:parser && npm run check:items",
    "check:items": "esbuild scripts/item-check.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/item-check.cjs --log-level=error && node node_modules/.cache/item-check.cjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
